{
  "name": "phantom-life",
  "productName": "Phantom Life",
  "version": "1.0.0",
  "description": "A Persona 5 styled life tracker. Take your time.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "test": "playwright test",
    "package": "npx --yes @electron/packager . \"Phantom Life\" --platform=darwin --overwrite --out=dist --icon=build/icon.icns --app-bundle-id=local.phantomlife --ignore=^/dist --ignore=^/build --ignore=^/tests --ignore=^/test-results --ignore=^/playwright",
    "install_app": "npm run package && rm -rf \"/Applications/Phantom Life.app\" && cp -R \"dist/Phantom Life-darwin-arm64/Phantom Life.app\" /Applications/ && codesign --force --deep --sign - \"/Applications/Phantom Life.app\" && echo Installed to /Applications",
    "package:win": "npx --yes @electron/packager . \"Phantom Life\" --platform=win32 --overwrite --out=dist --icon=src/assets/icon.ico --ignore=^/dist --ignore=^/build --ignore=^/scripts --ignore=^/tests --ignore=^/test-results --ignore=^/playwright",
    "install_app:win": "npm run package:win && node scripts/install-win.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "electron": "^44.9.0"
  }
}
