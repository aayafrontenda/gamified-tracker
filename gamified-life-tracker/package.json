{
  "name": "phantom-life",
  "productName": "Phantom Life",
  "version": "1.0.0",
  "description": "A Persona 5 styled life tracker. Take your time.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node scripts/start.js",
    "test": "playwright test",
    "package": "npx --yes @electron/packager . \"Phantom Life\" --platform=darwin --overwrite --out=dist --icon=build/icon.icns --app-bundle-id=local.phantomlife --ignore=^/dist --ignore=^/build --ignore=^/tests --ignore=^/test-results --ignore=^/playwright",
    "install_app": "npm run package && rm -rf \"/Applications/Phantom Life.app\" && cp -R \"dist/Phantom Life-darwin-arm64/Phantom Life.app\" /Applications/ && codesign --force --deep --sign - \"/Applications/Phantom Life.app\" && echo Installed to /Applications",
    "package:win": "electron-builder --win --dir && node scripts/make-squirrel.js",
    "package:mac": "electron-builder --mac",
    "splash": "node scripts/make-splash.js",
    "dmg-background": "node scripts/make-dmg-background.js",
    "install_app:win": "npm run package:win && node scripts/install-win.js"
  },
  "build": {
    "appId": "local.phantomlife",
    "productName": "Phantom Life",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*"
    ],
    "win": {
      "icon": "src/assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Phantom Life",
      "artifactName": "Phantom Life ${version} ${arch}.${ext}",
      "background": "build/installer/dmg-background.png",
      "iconSize": 80,
      "contents": [
        {
          "x": 135,
          "y": 190
        },
        {
          "x": 405,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.18.0",
    "electron-winstaller": "^5.4.4",
    "gifenc": "^1.0.3"
  }
}
